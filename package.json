{
  "name": "tailwind-react-modal",
  "version": "3.0.0",
  "description": "Accessible, animated React modal for Tailwind CSS 4 — seven shipped themes (terminal, brutalist, glass, editorial, neon, minimal), ready-made and composable layouts, focus trap, inert background, mobile bottom sheet, dark mode, zero dependencies",
  "author": "Guillaume-da",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Guillaume-da/react-tailwind-flex-modal.git"
  },
  "keywords": [
    "react",
    "tailwind",
    "tailwindcss",
    "modal",
    "dialog",
    "react modal",
    "tailwind modal",
    "react tailwind modal",
    "modal themes",
    "themed modal",
    "terminal ui",
    "accessible",
    "a11y",
    "focus-trap",
    "bottom-sheet",
    "animation",
    "approval-modal"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "run-s build:js build:css",
    "build:js": "tsup",
    "build:css": "tailwindcss -i src/tailwind.css -o dist/index.css --minify",
    "dev": "tsup --watch",
    "prepare": "run-s build",
    "test": "run-s test:types test:unit test:lint test:build",
    "test:types": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:lint": "eslint .",
    "test:build": "run-s build",
    "test:watch": "vitest",
    "predeploy": "cd examples && npm install && npm run build",
    "deploy": "gh-pages -d examples/dist"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "gh-pages": "^6.3.0",
    "globals": "^15.15.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
